# ==============================================================================
# K8sControl — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as required for your environment.
# cp .env.example .env
#
# NOTE: Secrets below contain safe placeholder strings. Generate your own
# cryptographically secure keys before running in staging or production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mandatory Security & Cryptography Keys (REQUIRED)
# ------------------------------------------------------------------------------
# JWT signing key (HMAC-SHA256). Must be at least 32 characters long.
# Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-random-32-byte-secret-key-for-jwt

# 256-bit encryption key for AES-256-GCM. Used to encrypt cluster credentials,
# cloud tokens, SSH keys, and compute host secrets in PostgreSQL.
# Must be at least 32 characters or a 64-character hex string.
# Generate (hex): openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional Bearer token for accessing the Prometheus /metrics endpoint.
# If left empty, /metrics is accessible without authentication.
METRICS_TOKEN=

# Allowed CORS origins (comma-separated). Default is '*' if left empty.
# In production, specify exact origins, e.g. https://k8s.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Enable pprof profiling endpoints under /debug/pprof (requires platform_admin role)
K8S_ENABLE_PPROF=false

# ------------------------------------------------------------------------------
# 2. HTTP Server Configuration
# ------------------------------------------------------------------------------
# Host interface and port the backend API server will listen on.
K8S_SERVER_HOST=0.0.0.0
K8S_SERVER_PORT=8080
K8S_SERVER_READ_TIMEOUT=30s
K8S_SERVER_WRITE_TIMEOUT=30s
K8S_SERVER_IDLE_TIMEOUT=120s

# Logging level: debug | info | warn | error
K8S_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Match these to your local PostgreSQL instance or docker compose (postgre.yml)
K8S_POSTGRES_HOST=localhost
K8S_POSTGRES_PORT=5432
K8S_POSTGRES_USER=myuser
K8S_POSTGRES_PASSWORD=mysecretpassword
K8S_POSTGRES_DBNAME=mydatabase
K8S_POSTGRES_SSLMODE=disable
K8S_POSTGRES_MAX_CONNS=25
K8S_POSTGRES_MIN_CONNS=5

# Migration Runner Aliases (used by ./scripts/migrate)
DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mysecretpassword
DB_NAME=mydatabase
DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# 4. Redis Cache Configuration (Required in Server Mode, Optional in Standalone)
# ------------------------------------------------------------------------------
K8S_REDIS_HOST=localhost
K8S_REDIS_PORT=6379
K8S_REDIS_PASSWORD=
K8S_REDIS_DB=0

# ------------------------------------------------------------------------------
# 5. NATS JetStream Configuration (Required in Server Mode, Optional in Standalone)
# ------------------------------------------------------------------------------
K8S_NATS_URL=nats://localhost:4222
K8S_NATS_MAX_RECONNECTS=60
K8S_NATS_RECONNECT_WAIT=2s
K8S_NATS_STREAM_NAME=INCIDENTS
K8S_NATS_STREAM_SUBJECTS=incidents.>

# ------------------------------------------------------------------------------
# 6. Docker Engine Integration
# ------------------------------------------------------------------------------
# On Linux/macOS: unix:///var/run/docker.sock
# On Windows Docker Desktop: npipe:////./pipe/docker_engine
# Remote TCP: tcp://10.10.10.133:2375
K8S_DOCKER_HOST=unix:///var/run/docker.sock
K8S_DOCKER_VERSION=1.41

# ------------------------------------------------------------------------------
# 7. LLM & AI Root Cause Analysis Configuration
# ------------------------------------------------------------------------------
# Provider type: ollama | openai | vllm
K8S_LLM_PROVIDER=ollama
K8S_LLM_ENDPOINT=http://localhost:11434
K8S_LLM_MODEL=llama3
K8S_LLM_API_KEY=

# ------------------------------------------------------------------------------
# 8. OpenTelemetry & Observability (Optional)
# ------------------------------------------------------------------------------
K8S_TELEMETRY_SERVICE_NAME=k8sselfhost
K8S_TELEMETRY_SERVICE_VERSION=0.1.0
K8S_TELEMETRY_OTLP_ENDPOINT=
K8S_TELEMETRY_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 9. Kubernetes Cluster Integration (Optional)
# ------------------------------------------------------------------------------
# Path to primary kubeconfig for local cluster discovery.
# If unset, defaults to ~/.kube/config or %USERPROFILE%\.kube\config
KUBECONFIG=
